<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build only. Every executable in a Mac App Store app must be
     sandboxed; the tool runs from Terminal, so it has its own sandbox rather
     than inheriting the app's. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Reaches the app's control socket in the shared App Group container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)org.dasmart.vegabar</string>
	</array>
</dict>
</plist>
